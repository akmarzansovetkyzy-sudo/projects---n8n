    {
      "parameters": {
        "url": "=https://www.googleapis.com/drive/v3/files/{{$('Build Google Docs Replacements').item.json.google_doc_id}}/export?mimeType={{encodeURIComponent($('Build Google Docs Replacements').item.json.export_mime_type)}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
