      "id": "f7e37993-2671-4f3b-89d6-52a0ad58fe1b",
      "name": "Google Drive Export DOCX Or PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        9488,
        -592
      ],
      "credentials": {
        "oAuth2Api": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Google OAuth2 account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const original = $('Build Google Docs Replacements').item.json;\n\nif (!$binary || !$binary.data) {\n  throw new Error('No binary file found from Google Drive Export');\n}\n\nfunction safeFileName(name) {\n  return String(name || 'contract.pdf')\n    .replace(/[\\\\/:*?\"<>|№]/g, '-')\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\nconst safeName = safeFileName(original.output_file_name);\n\n$binary.data.fileName = safeName;\n$binary.data.mimeType = original.export_mime_type;\n\nreturn [\n  {\n    json: {\n      ...original,\n      output_file_name: safeName\n    },\n    binary: {\n      data: $binary.data\n    }\n  }\n];"
      },
      "id": "41c5eaa9-ecae-41a8-a481-0d0bb98fe528",
      "name": "Set Output File Name",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        9728,
        -592
      ]
    },
    {
      "parameters": {
        "operation": "sendDocument",
        "chatId": "={{ $json.chat_id }}",
        "binaryData": true,
        "additionalFields": {
          "caption": "={{ $json.warnings && $json.warnings.length ? 'Договор сформирован.\\n\\nПредупреждения по проверке реквизитов/подписей/печатей:\\n- ' + $json.warnings.join('\\n- ') : 'Договор сформирован.' }}"
        }
      },
