        "url": "=https://www.googleapis.com/drive/v3/files/{{$json.template_id || ($json.contract_type === '01' ? $json.template_01_id : $json.template_02_id)}}/copy",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ name: $json.copy_name || ('Договор №' + ($json.contract_number || '')) }) }}",
        "options": {}
