          "name": "Google OAuth2 account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\n// Сессия пользователя хранится в staticData воркфлоу WF1 (там, где Normalize Telegram Input её создал).\n// Этот суб-воркфлоу (WF2) не имеет доступа к staticData WF1, поэтому здесь сессию НЕ чистим.\n// Вместо этого просто прокидываем session_keys дальше — WF1 очистит сессию сам\n// сразу после того, как получит результат от Execute Workflow (см. ноду в WF1).\n\nlet original = {};\ntry {\n  original = $('Set Output File Name').item.json || {};\n} catch (e) {\n  original = {};\n}\n\nconst chatId = String($json.chat_id || original.chat_id || '');\nconst userId = $json.user_id || original.user_id || null;\nconst sessionKeys =\n  ($json.session_keys && $json.session_keys.length)\n    ? $json.session_keys\n    : (original.session_keys && original.session_keys.length)\n      ? original.session_keys\n      : [chatId, userId ? `user:${userId}` : null].filter(Boolean);\n\nreturn [{\n  json: {\n    ...original,\n    ...$json,\n    chat_id: chatId,\n    user_id: userId,\n    session_keys: sessionKeys,\n    session_version: original.session_version || $json.session_version || null,\n    session_cleared: false\n  },\n  binary: $binary\n}];\n"
      },
      "id": "dfc06d64-6be6-455b-817d-086884252488",
      "name": "Подготовить session_keys для очистки",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        10208,
        -576
      ]
    },
