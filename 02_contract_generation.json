      "id": "a4c71b3f-2699-40a9-8c53-de934017c7f9",
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        8320,
        -592
      ]
    },
    {
      "parameters": {
        "jsCode": "const copiedId = $json.id;\n\n// Берём свежие данные договора из guard-узла, который стоит перед копированием шаблона.\nconst original = $('Guard Active Session Input').first().json;\n\nif (!original?.replacements) {\n  throw new Error('Build Google Docs Replacements: нет replacements во входных данных воркфлоу. Проверь, что Execute Workflow в WF1 передаёт поле replacements.');\n}\n\nconst requests = [];\n\nfor (const [key, value] of Object.entries(original.replacements || {})) {\n  requests.push({\n    replaceAllText: {\n      containsText: {\n        text: key,\n        matchCase: true\n      },\n      replaceText: String(value ?? '')\n    }\n  });\n}\n\nif (original.requisites?.director_gender === 'female') {\n  requests.push({\n    replaceAllText: {\n      containsText: {\n        text: 'действующего на основании',\n        matchCase: false\n      },\n      replaceText: 'действующей на основании'\n    }\n  });\n}\n\nif (!requests.length) {\n  throw new Error('Build Google Docs Replacements: requests пустой. В original.replacements нет переменных для замены.');\n}\n\nreturn [{\n  json: {\n    ...original,\n    google_doc_id: copiedId,\n    copy_result: $json,\n    batch_update_body: {\n      requests\n    }\n  }\n}];"
      },
      "id": "f9469a4b-424b-42ab-a0ce-a3fc8294a4e1",
      "name": "Build Google Docs Replacements",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        9024,
        -592
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://docs.googleapis.com/v1/documents/{{$json.google_doc_id}}:batchUpdate",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.batch_update_body }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "164228fe-3e06-4e22-be68-2eb441452260",
