        "jsCode": "const input = { ...$json };\n\nif (!input.chat_id || !input.replacements || !input.template_id || !input.copy_name) {\n  throw new Error(\n    'Guard Active Session Input: нет обязательных данных договора (chat_id/replacements/template_id/copy_name).'\n  );\n}\n\nreturn [{ json: input }];"
      },
